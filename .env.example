# docker compose가 자동으로 읽는 파일 (cp .env.example .env)
POSTGRES_DB=db
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# 운영에서는 반드시 무작위 키를 넣는다. 개발은 비워 두면 실행할 때마다 자동으로 만든다.
# 생성: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# 브라우저 -> 백엔드. 호스트에 바인딩된 백엔드 포트(8003)를 가리켜야 한다.
VITE_API_URL=http://localhost:8003/api/v1

# 숙소 검색용 Google Places API (New) 키. 백엔드에서만 사용한다.
GOOGLE_PLACES_API_KEY=

# 여행 상세 지도용 Maps JavaScript API 키. 브라우저에 노출되므로 HTTP 리퍼러로 제한한 별도 키를 쓴다.
GOOGLE_MAPS_API_KEY=

# 소셜 로그인 (카카오 REST API 키 / 네이버 Client ID는 프론트 인가 URL에도 쓰인다)
# Redirect URI 등록: http://localhost:8002/auth/kakao/callback, http://localhost:8002/auth/naver/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 일행 초대 카카오톡 공유용 JavaScript 키 (카카오 개발자 콘솔 > 앱 키 > JavaScript 키)
# 플랫폼 > Web > 사이트 도메인에 http://localhost:8002 등록이 필요하다. 비어 있으면 링크 복사만 쓸 수 있다.
KAKAO_JS_KEY=

# 여행 상세 'AI와 함께 만들기'용 Claude API 키 (백엔드에서만 사용)
ANTHROPIC_API_KEY=

# AI 일정 제안의 실제 이동 시간 계산용 Google Routes API 키 (백엔드 전용, 유료 API).
# Google Cloud에서 Routes API를 활성화하고 이 키를 Routes API만 허용하도록 제한한다. 비어 있으면 직선거리 기준으로 동작한다.
GOOGLE_ROUTES_API_KEY=
# 일본 대중교통 이동 시간용 NAVITIME Route(totalnavi) RapidAPI 키 (백엔드 전용). Google Routes API는 일본 대중교통을 제공하지 않는다.
# 무료 요금제는 월 500건 하드 리밋이라 호출 수를 제한한다(NAVITIME_MAX_REQUESTS_PER_PROPOSAL, NAVITIME_MONTHLY_REQUESTS). 비우면 대중교통 시간은 표시하지 않는다.
NAVITIME_RAPIDAPI_KEY=
# 지원 지역: 나라 코드(ISO). 일본은 NAVITIME, 그 밖의 나라는 Google 대중교통 결과를 쓴다(중국 본토는 Google이 대중교통을 주지 않아 제외).
ROUTES_COUNTRIES=JP,KR,TW,HK,MO,MN
# 나라 목록 밖에서 따로 더할 도시 id (쉼표로 구분, 비워 둬도 된다)
ROUTES_CITIES=
# 비용 제한: 요소(출발지×도착지 쌍) 수. 제안 한 번 / 사용자별 하루 / 전체 하루
ROUTES_MAX_ELEMENTS_PER_PROPOSAL=300
ROUTES_USER_DAILY_ELEMENTS=600
ROUTES_DAILY_ELEMENTS=3000
# 한 번에 끄려면 0 (직선거리 기준으로 동작)
ROUTES_ENABLED=1

# 이메일 변경 인증 메일(SMTP). 비워 두면 개발에서는 메일 내용이 백엔드 로그(docker compose logs backend)에 찍힌다.
# 예) Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=계정, EMAIL_HOST_PASSWORD=앱 비밀번호
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=PinRoute <no-reply@pinroute.local>
# 인증 메일 속 링크가 가리키는 프론트 주소
FRONTEND_URL=http://localhost:8002

# 로그인 만료 정책(서버 시계 기준, 일 단위). 비활동: 마지막 사용자 활동 후 N일 / 절대: 로그인 후 N일(활동해도 연장 안 됨)
AUTH_INACTIVITY_DAYS=7
AUTH_ABSOLUTE_DAYS=30
